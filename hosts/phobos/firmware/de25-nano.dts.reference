/dts-v1/;

/ {
	compatible = "intel,socfpga-agilex5-socdk", "intel,socfpga-agilex5";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "SoCFPGA Agilex5 Terasic DE25-Nano";

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		svcbuffer@0 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x80000000 0x00 0x2000000>;
			alignment = <0x1000>;
			no-map;
			phandle = <0x08>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <0x01>;
			phandle = <0x04>;
		};

		cpu@1 {
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <0x01>;
			phandle = <0x05>;
		};

		cpu@2 {
			compatible = "arm,cortex-a76";
			reg = <0x200>;
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <0x01>;
			phandle = <0x06>;
		};

		cpu@3 {
			compatible = "arm,cortex-a76";
			reg = <0x300>;
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <0x01>;
			phandle = <0x07>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			next-level-cache = <0x02>;
			phandle = <0x01>;
		};

		l3-cache {
			compatible = "cache";
			phandle = <0x02>;
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	interrupt-controller@1d000000 {
		compatible = "arm,gic-v3";
		reg = <0x00 0x1d000000 0x00 0x10000 0x00 0x1d060000 0x00 0x100000>;
		ranges;
		#interrupt-cells = <0x03>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		interrupt-controller;
		interrupt-parent = <0x03>;
		#redistributor-regions = <0x01>;
		redistributor-stride = <0x00 0x20000>;
		interrupts = <0x01 0x19 0x04>;
		phandle = <0x03>;

		msi-controller@1d040000 {
			compatible = "arm,gic-v3-its";
			reg = <0x00 0x1d040000 0x00 0x20000>;
			msi-controller;
			dma-32bit-quirk;
			#msi-cells = <0x01>;
		};
	};

	clocks {

		cb-intosc-hs-div2-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x00>;
		};

		cb-intosc-ls-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x00>;
		};

		f2s-free-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x00>;
		};

		osc1 {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x17d7840>;
		};

		qspi-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0xbebc200>;
			phandle = <0x20>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x03>;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	usbphy {
		#phy-cells = <0x00>;
		compatible = "usb-nop-xceiv";
		phandle = <0x1a>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x03>;
		interrupts = <0x01 0x07 0x08>;
		cpus = <0x04 0x05 0x06 0x07>;
	};

	pmu-tcu@16002000 {
		compatible = "arm,smmu-v3-pmcg";
		reg = <0x00 0x16002000 0x00 0x1000 0x00 0x16022000 0x00 0x1000>;
		interrupt-parent = <0x03>;
		interrupts = <0x00 0x88 0x01>;
	};

	pmu-tbu@16042000 {
		compatible = "arm,smmu-v3-pmcg";
		reg = <0x00 0x16042000 0x00 0x1000 0x00 0x16052000 0x00 0x1000>;
		interrupt-parent = <0x03>;
		interrupts = <0x00 0x8a 0x01>;
	};

	pmu-tbu@16062000 {
		compatible = "arm,smmu-v3-pmcg";
		reg = <0x00 0x16062000 0x00 0x1000 0x00 0x16072000 0x00 0x1000>;
		interrupt-parent = <0x03>;
		interrupts = <0x00 0x8c 0x01>;
	};

	pmu-tbu@16082000 {
		compatible = "arm,smmu-v3-pmcg";
		reg = <0x00 0x16082000 0x00 0x1000 0x00 0x16092000 0x00 0x1000>;
		interrupt-parent = <0x03>;
		interrupts = <0x00 0x8e 0x01>;
	};

	pmu-tbu@160A2000 {
		compatible = "arm,smmu-v3-pmcg";
		reg = <0x00 0x160a2000 0x00 0x1000 0x00 0x160b2000 0x00 0x1000>;
		interrupt-parent = <0x03>;
		interrupts = <0x00 0x90 0x01>;
	};

	pmu-tbu@160C2000 {
		compatible = "arm,smmu-v3-pmcg";
		reg = <0x00 0x160c2000 0x00 0x1000 0x00 0x160d2000 0x00 0x1000>;
		interrupt-parent = <0x03>;
		interrupts = <0x00 0x92 0x01>;
	};

	pmu-tbu@160E2000 {
		compatible = "arm,smmu-v3-pmcg";
		reg = <0x00 0x160e2000 0x00 0x1000 0x00 0x160f2000 0x00 0x1000>;
		interrupt-parent = <0x03>;
		interrupts = <0x00 0x96 0x01>;
	};

	firmware {

		svc {
			compatible = "intel,agilex5-svc";
			method = "smc";
			memory-region = <0x08>;
			iommus = <0x09 0x0a>;
			interrupts = <0x00 0x00 0x04>;
			interrupt-parent = <0x03>;
			altr,smmu_enable_quirk;

			fpga-mgr {
				compatible = "intel,agilex5-soc-fpga-mgr";
				altr,smmu_enable_quirk;
				phandle = <0x0a>;
			};

			hwmon {
				compatible = "intel,soc64-hwmon";

				voltage {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					input@2 {
						label = "0.8V VCC";
						reg = <0x02>;
					};

					input@3 {
						label = "1.8V VCCIO_SDM";
						reg = <0x03>;
					};

					input@4 {
						label = "1.8V VCCPT";
						reg = <0x04>;
					};

					input@5 {
						label = "1.2V VCCCRCORE";
						reg = <0x05>;
					};

					input@6 {
						label = "0.9V VCCH";
						reg = <0x06>;
					};

					input@7 {
						label = "0.8V VCCL";
						reg = <0x07>;
					};
				};

				temperature {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					input@0 {
						label = "Main Die SDM";
						reg = <0x00>;
					};

					input@10001 {
						label = "Main Die corner bottom left max";
						reg = <0x10000>;
					};

					input@30001 {
						label = "Main Die corner bottom right max";
						reg = <0x30000>;
					};

					input@40001 {
						label = "Main Die corner top right max";
						reg = <0x40000>;
					};
				};
			};

			fcs-hal {
				compatible = "intel,agilex5-soc-fcs-hal";
				phandle = <0x0b>;
			};
		};
	};

	fpga-region {
		compatible = "fpga-region";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		fpga-mgr = <0x0a>;
	};

	fcs-crypto {
		compatible = "intel,agilex5-soc-fcs-crypto";
		dependent-on = <0x0b>;
	};

	fcs-config {
		compatible = "intel,agilex5-soc-fcs-config";
		dependent-on = <0x0b>;
	};

	soc@0 {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0xffffffff>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		device_type = "soc";
		interrupt-parent = <0x03>;

		clock-controller@10d10000 {
			compatible = "intel,agilex5-clkmgr";
			reg = <0x10d10000 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x0d>;
		};

		ethernet@10830000 {
			compatible = "altr,socfpga-stmmac-a10-s10", "snps,dwxgmac-2.10", "snps,dwxgmac";
			reg = <0x10830000 0x3500>;
			interrupts = <0x00 0xe0 0x04 0x00 0xe1 0x04 0x00 0xe2 0x04 0x00 0xe3 0x04 0x00 0xe4 0x04 0x00 0xe5 0x04 0x00 0xe6 0x04 0x00 0xe7 0x04 0x00 0xe8 0x04 0x00 0xe9 0x04 0x00 0xea 0x04 0x00 0xeb 0x04 0x00 0xec 0x04 0x00 0xed 0x04 0x00 0xee 0x04 0x00 0xef 0x04 0x00 0xf0 0x04>;
			interrupt-names = "macirq", "macirq_tx0", "macirq_tx1", "macirq_tx2", "macirq_tx3", "macirq_tx4", "macirq_tx5", "macirq_tx6", "macirq_tx7", "macirq_rx0", "macirq_rx1", "macirq_rx2", "macirq_rx3", "macirq_rx4", "macirq_rx5", "macirq_rx6", "macirq_rx7";
			resets = <0x0c 0x22 0x0c 0x2a>;
			reset-names = "stmmaceth", "stmmaceth-ocp";
			clocks = <0x0d 0x30 0x0d 0x31>;
			clock-names = "stmmaceth", "ptp_ref";
			mac-address = [00 00 00 00 00 00];
			tx-fifo-depth = <0x8000>;
			rx-fifo-depth = <0x4000>;
			snps,multicast-filter-bins = <0x40>;
			snps,perfect-filter-entries = <0x40>;
			snps,axi-config = <0x0e>;
			snps,mtl-rx-config = <0x0f>;
			snps,mtl-tx-config = <0x10>;
			snps,pbl = <0x20>;
			snps,pblx8;
			snps,multi-irq-en;
			snps,tso;
			snps,rx-vlan-offload;
			altr,sysmgr-syscon = <0x11 0x4c 0x00>;
			altr,smtg-hub;
			iommus = <0x09 0x03>;
			snps,clk-csr = <0x00>;
			dma-coherent;
			status = "disabled";
			phandle = <0x1e>;

			stmmac-axi-config {
				snps,wr_osr_lmt = <0x1f>;
				snps,rd_osr_lmt = <0x1f>;
				snps,blen = <0x00 0x00 0x00 0x20 0x10 0x08 0x04>;
				phandle = <0x0e>;
			};

			rx-queues-config {
				snps,rx-queues-to-use = <0x08>;
				snps,rx-sched-sp;
				phandle = <0x0f>;

				queue0 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x00>;
				};

				queue1 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x01>;
				};

				queue2 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x02>;
				};

				queue3 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x03>;
				};

				queue4 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x04>;
				};

				queue5 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x05>;
				};

				queue6 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x06>;
				};

				queue7 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x07>;
				};
			};

			tx-queues-config {
				snps,tx-queues-to-use = <0x08>;
				snps,tx-queues-with-coe = <0x02>;
				snps,tx-sched-wrr;
				phandle = <0x10>;

				queue0 {
					snps,weight = <0x09>;
					snps,dcb-algorithm;
				};

				queue1 {
					snps,weight = <0x0a>;
					snps,dcb-algorithm;
				};

				queue2 {
					snps,weight = <0x0b>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue3 {
					snps,weight = <0x0c>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue4 {
					snps,weight = <0x0d>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue5 {
					snps,weight = <0x0e>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue6 {
					snps,weight = <0x0f>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
					snps,tbs-enable;
				};

				queue7 {
					snps,weight = <0x10>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
					snps,tbs-enable;
				};
			};
		};

		ethernet@10810000 {
			compatible = "altr,socfpga-stmmac-a10-s10", "snps,dwxgmac-2.10", "snps,dwxgmac";
			reg = <0x10810000 0x3500>;
			interrupts = <0x00 0xbe 0x04 0x00 0xbf 0x04 0x00 0xc0 0x04 0x00 0xc1 0x04 0x00 0xc2 0x04 0x00 0xc3 0x04 0x00 0xc4 0x04 0x00 0xc5 0x04 0x00 0xc6 0x04 0x00 0xc7 0x04 0x00 0xc8 0x04 0x00 0xc9 0x04 0x00 0xca 0x04 0x00 0xcb 0x04 0x00 0xcc 0x04 0x00 0xcd 0x04 0x00 0xce 0x04>;
			interrupt-names = "macirq", "macirq_tx0", "macirq_tx1", "macirq_tx2", "macirq_tx3", "macirq_tx4", "macirq_tx5", "macirq_tx6", "macirq_tx7", "macirq_rx0", "macirq_rx1", "macirq_rx2", "macirq_rx3", "macirq_rx4", "macirq_rx5", "macirq_rx6", "macirq_rx7";
			resets = <0x0c 0x20 0x0c 0x28>;
			reset-names = "stmmaceth", "stmmaceth-ocp";
			clocks = <0x0d 0x2e 0x0d 0x31>;
			clock-names = "stmmaceth", "ptp_ref";
			mac-address = [00 00 00 00 00 00];
			tx-fifo-depth = <0x8000>;
			rx-fifo-depth = <0x4000>;
			snps,multicast-filter-bins = <0x40>;
			snps,perfect-filter-entries = <0x40>;
			snps,axi-config = <0x12>;
			snps,mtl-rx-config = <0x13>;
			snps,mtl-tx-config = <0x14>;
			snps,pbl = <0x20>;
			snps,pblx8;
			snps,multi-irq-en;
			snps,tso;
			snps,rx-vlan-offload;
			altr,sysmgr-syscon = <0x11 0x44 0x00>;
			altr,smtg-hub;
			iommus = <0x09 0x01>;
			snps,clk-csr = <0x00>;
			dma-coherent;
			status = "okay";
			phy-mode = "rgmii";
			phy-handle = <0x15>;
			max-frame-size = <0x2328>;
			phandle = <0x1c>;

			stmmac-axi-config {
				snps,wr_osr_lmt = <0x1f>;
				snps,rd_osr_lmt = <0x1f>;
				snps,blen = <0x00 0x00 0x00 0x20 0x10 0x08 0x04>;
				phandle = <0x12>;
			};

			rx-queues-config {
				snps,rx-queues-to-use = <0x08>;
				snps,rx-sched-sp;
				phandle = <0x13>;

				queue0 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x00>;
				};

				queue1 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x01>;
				};

				queue2 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x02>;
				};

				queue3 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x03>;
				};

				queue4 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x04>;
				};

				queue5 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x05>;
				};

				queue6 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x06>;
				};

				queue7 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x07>;
				};
			};

			tx-queues-config {
				snps,tx-queues-to-use = <0x08>;
				snps,tx-queues-with-coe = <0x02>;
				snps,tx-sched-wrr;
				phandle = <0x14>;

				queue0 {
					snps,weight = <0x09>;
					snps,dcb-algorithm;
				};

				queue1 {
					snps,weight = <0x0a>;
					snps,dcb-algorithm;
				};

				queue2 {
					snps,weight = <0x0b>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue3 {
					snps,weight = <0x0c>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue4 {
					snps,weight = <0x0d>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue5 {
					snps,weight = <0x0e>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue6 {
					snps,weight = <0x0f>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
					snps,tbs-enable;
				};

				queue7 {
					snps,weight = <0x10>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
					snps,tbs-enable;
				};
			};

			mdio0 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "snps,dwmac-mdio";

				ethernet-phy@0 {
					reg = <0x01>;
					phandle = <0x15>;
				};
			};
		};

		ethernet@10820000 {
			compatible = "altr,socfpga-stmmac-a10-s10", "snps,dwxgmac-2.10", "snps,dwxgmac";
			reg = <0x10820000 0x3500>;
			interrupts = <0x00 0xcf 0x04 0x00 0xd0 0x04 0x00 0xd1 0x04 0x00 0xd2 0x04 0x00 0xd3 0x04 0x00 0xd4 0x04 0x00 0xd5 0x04 0x00 0xd6 0x04 0x00 0xd7 0x04 0x00 0xd8 0x04 0x00 0xd9 0x04 0x00 0xda 0x04 0x00 0xdb 0x04 0x00 0xdc 0x04 0x00 0xdd 0x04 0x00 0xde 0x04 0x00 0xdf 0x04>;
			interrupt-names = "macirq", "macirq_tx0", "macirq_tx1", "macirq_tx2", "macirq_tx3", "macirq_tx4", "macirq_tx5", "macirq_tx6", "macirq_tx7", "macirq_rx0", "macirq_rx1", "macirq_rx2", "macirq_rx3", "macirq_rx4", "macirq_rx5", "macirq_rx6", "macirq_rx7";
			resets = <0x0c 0x21 0x0c 0x29>;
			reset-names = "stmmaceth", "stmmaceth-ocp";
			clocks = <0x0d 0x2f 0x0d 0x31>;
			clock-names = "stmmaceth", "ptp_ref";
			mac-address = [00 00 00 00 00 00];
			tx-fifo-depth = <0x8000>;
			rx-fifo-depth = <0x4000>;
			snps,multicast-filter-bins = <0x40>;
			snps,perfect-filter-entries = <0x40>;
			snps,axi-config = <0x16>;
			snps,mtl-rx-config = <0x17>;
			snps,mtl-tx-config = <0x18>;
			snps,pbl = <0x20>;
			snps,pblx8;
			snps,multi-irq-en;
			snps,tso;
			snps,rx-vlan-offload;
			altr,sysmgr-syscon = <0x11 0x48 0x00>;
			altr,smtg-hub;
			iommus = <0x09 0x02>;
			snps,clk-csr = <0x00>;
			dma-coherent;
			status = "disabled";
			phandle = <0x1d>;

			stmmac-axi-config {
				snps,wr_osr_lmt = <0x1f>;
				snps,rd_osr_lmt = <0x1f>;
				snps,blen = <0x00 0x00 0x00 0x20 0x10 0x08 0x04>;
				phandle = <0x16>;
			};

			rx-queues-config {
				snps,rx-queues-to-use = <0x08>;
				snps,rx-sched-sp;
				phandle = <0x17>;

				queue0 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x00>;
				};

				queue1 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x01>;
				};

				queue2 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x02>;
				};

				queue3 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x03>;
				};

				queue4 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x04>;
				};

				queue5 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x05>;
				};

				queue6 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x06>;
				};

				queue7 {
					snps,dcb-algorithm;
					snps,map-to-dma-channel = <0x07>;
				};
			};

			tx-queues-config {
				snps,tx-queues-to-use = <0x08>;
				snps,tx-queues-with-coe = <0x02>;
				snps,tx-sched-wrr;
				phandle = <0x18>;

				queue0 {
					snps,weight = <0x09>;
					snps,dcb-algorithm;
				};

				queue1 {
					snps,weight = <0x0a>;
					snps,dcb-algorithm;
				};

				queue2 {
					snps,weight = <0x0b>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue3 {
					snps,weight = <0x0c>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue4 {
					snps,weight = <0x0d>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue5 {
					snps,weight = <0x0e>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
				};

				queue6 {
					snps,weight = <0x0f>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
					snps,tbs-enable;
				};

				queue7 {
					snps,weight = <0x10>;
					snps,coe-unsupported;
					snps,dcb-algorithm;
					snps,tbs-enable;
				};
			};
		};

