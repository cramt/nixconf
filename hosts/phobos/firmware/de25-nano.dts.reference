		};

		spi@108d2000 {
			compatible = "intel,socfpga-qspi", "cdns,qspi-nor";
			reg = <0x108d2000 0x100 0x10900000 0x100000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x03 0x04>;
			cdns,fifo-depth = <0x80>;
			cdns,fifo-width = <0x04>;
			cdns,trigger-address = <0x00>;
			clocks = <0x20>;
			status = "disabled";
		};
	};

	aliases {
		serial0 = "/soc@0/serial@10c02100";
		ethernet0 = "/soc@0/ethernet@10810000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=uart8250,mmio32,0x10c02000,115200n8 \t\t\troot=/dev/ram0 rw initrd=0x10000000 init=/sbin/init \t\t\tramdisk_size=10000000 earlycon=uart8250,mmio32,0x10c02000,115200n8 \t\t\tpanic=-1 rootfstype=ext3";
	};

	leds {
		compatible = "gpio-leds";

		hps0 {
			label = "hps_led0";
			gpios = <0x21 0x11 0x01>;
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x80000000>;
	};
};
